# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# Postgres credentials (used by the db container and assembled into
# DATABASE_URL for the app automatically — you don't need to set
# DATABASE_URL yourself when using docker-compose.yml).
POSTGRES_USER=rail_cut
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rail_cut

# Random long string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me

# PIN required to unlock admin mode (add/remove saved dimensions) in the app.
ADMIN_PIN=change-me

# Host port the app is published on (container always listens on 8080).
APP_PORT=8080
